<form
    addfieldprefix="Ramblers\Component\Ra_library\Administrator\Field"
>
    <fieldset name="controls" label="">
        <field name="enabled" 
               type="radio" 
               layout="joomla.form.field.radio.switcher"
               default="1"
               label="Enabled" 
               class="switcher">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="introduction"
               type="list" 
               default="0"
               label="Add introduction before list" 
               description="" 
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>    
        </field> 
        <field name="introductiontext" 
               showon="introduction:1"
               type="editor" 
               buttons="true" 
               class="inputbox" 
               filter="safehtml" 
               label="Text to display" 
               description="" 
               height="250"
        />
 
        <field
            name="document_folder"
            type="SelectFolder"
            label="Select folder"
            description="Browse folders and choose one"
            select="true"
            clear="true"
            titleSelect="Select folder"
            urlSelect="index.php?option=com_ra_library&amp;view=folder&amp;layout=modal&amp;tmpl=component"
        />
        <field name="sort"
               type="list" 
               default="0"
               label="Sort order" 
               description="" 
        >
            <option value="0">Ascending</option>
            <option value="1">Descending</option>    
        </field> 
        <field name="documents_exts" 
               type="tableitems" 
               sort='false'
               fieldsperitem ="1"
               fieldnames='["Extension"]'
               label="Allowed extension(s)" 
               description="specify which file extensions you wish to display, pdf, doc, etc" 
        />
    </fieldset>
    
   
</form>
