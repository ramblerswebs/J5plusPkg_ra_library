<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Ramblers\Component\Ra_library\Administrator\Field">
    <field name="id" type="hidden" filter="int"/>

    <field name="file_path"
           type="filepreview"
           label="COM_RA_LIBRARY_ATTACHMENT_FIELD_FILE_LABEL"
    />

    <field name="gpx_upload"
           type="file"
           accept=".gpx"
           label="COM_RA_LIBRARY_GPX_FIELD_UPLOAD_LABEL"
           description="COM_RA_LIBRARY_GPX_FIELD_UPLOAD_DESC"
    />

    <field name="title"
           type="text"
           label="COM_RA_LIBRARY_ATTACHMENT_FIELD_TITLE_LABEL"
           filter="safehtml"
           size="30"
    />

    <field name="featured"
           type="checkbox"
           label="COM_RA_LIBRARY_GPX_FIELD_FEATURED_LABEL"
           description="COM_RA_LIBRARY_GPX_FIELD_FEATURED_DESC"
           value="1"
    />

    <field name="download_override"
           type="list"
           default=""
           label="COM_RA_LIBRARY_GPX_FIELD_DOWNLOAD_OVERRIDE_LABEL"
           description="COM_RA_LIBRARY_GPX_FIELD_DOWNLOAD_OVERRIDE_DESC"
    >
        <option value="">COM_RA_LIBRARY_GPX_DOWNLOAD_OPTION_GLOBAL</option>
        <option value="None">COM_RA_LIBRARY_GPX_DOWNLOAD_OPTION_NONE</option>
        <option value="Users">COM_RA_LIBRARY_GPX_DOWNLOAD_OPTION_USERS</option>
        <option value="Public">COM_RA_LIBRARY_GPX_DOWNLOAD_OPTION_PUBLIC</option>
    </field>
</form>
