<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>plg_content_ra_library</name>
    <author>Chris Vaughan</author>
    <creationDate>9-11-2026</creationDate>
    <copyright>Copyright (C) 2026 Chris Vaughan. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>you@example.com</authorEmail>
    <authorUrl>https://example.com</authorUrl>
    <version>1.0.111</version>
    <description>PLG_CONTENT_RA_LIBRARY_XML_DESCRIPTION</description>

    <!-- PSR‑4 mapping -->
    <namespace path="src">Ramblers\Plugin\Content\Ra_library</namespace>

    <!-- Folders and files -->
    <files>
        <filename plugin="ra_library">ra_library.php</filename>
        <folder>src</folder>
        <folder>services</folder>
        <folder>language</folder>
    </files>

    <!-- Provider entry -->
    <services>
        <provider>services/provider.php</provider>
    </services>

    <languages>
        <language tag="en-GB">language/en-GB/plg_content_ra_library.ini</language>
        <language tag="en-GB">language/en-GB/plg_content_ra_library.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="specialist_tags"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_CONTENT_RA_LIBRARY_SPECIALIST_TAGS_LABEL"
                    description="PLG_CONTENT_RA_LIBRARY_SPECIALIST_TAGS_DESC"
                    default="0">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="specialist_tags_help"
                    type="note"
                    class="alert alert-info"
                    label="PLG_CONTENT_RA_LIBRARY_SPECIALIST_HELP_LABEL"
                    description="PLG_CONTENT_RA_LIBRARY_SPECIALIST_HELP_DESC"
                    showon="specialist_tags:1" />
            </fieldset>
            <fieldset name="csv" label="PLG_CONTENT_RA_LIBRARY_CSV_TAB">
                <field
                    name="csv_help"
                    type="note"
                    class="alert alert-info"
                    label="PLG_CONTENT_RA_LIBRARY_CSV_HELP_LABEL"
                    description="PLG_CONTENT_RA_LIBRARY_CSV_HELP_DESC" />
            </fieldset>
        </fields>
    </config>
</extension>